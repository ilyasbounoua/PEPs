<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" 
             xmlns="http://xmlns.jcp.org/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
  <!-- Define Persistence Unit -->
  <persistence-unit name="peps.peps_back.0PU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>peps.peps_back.items.Interaction</class>
    <class>peps.peps_back.items.Sound</class>
    <class>peps.peps_back.items.Module</class>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <properties>

    	<!-- PostgreSQL JDBC -->
    	<property name="javax.persistence.jdbc.driver"
             	 value="org.postgresql.Driver"/>

    	<property name="javax.persistence.jdbc.url"
      	        value="jdbc:postgresql://appli-pfe.ec-nantes.fr:5432/infosi_21?currentSchema=peps"/>

    	<property name="javax.persistence.jdbc.user"
         	     value="infosi_21"/>

    	<property name="javax.persistence.jdbc.password"
            	  value="frieren"/>

    	<!-- Forcer le schéma PostgreSQL -->
    	<property name="eclipselink.default-schema"
         	     value="peps"/>


    	<!-- Désactiver toute génération automatique du schéma -->
    	<property name="eclipselink.ddl-generation"
             	 value="none"/>

    </properties>
	

  </persistence-unit>
</persistence>
