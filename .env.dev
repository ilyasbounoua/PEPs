# ============================================
# PEPs Environment Configuration - DEVELOPMENT
# ============================================
# This file contains SAFE values for local development
# For production, use .env.prod.example as base

# Proxy Configuration
PROXY_PORT=80
PROXY_SSL_PORT=443

# Backend Configuration
SPRING_PROFILE=dev
DB_HOST=database
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=peps-sounds

# Frontend Configuration
API_URL=http://localhost/api

# Docker Resource Limits
BACKEND_MEMORY_LIMIT=1G
BACKEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256M
FRONTEND_CPU_LIMIT=0.5
PROXY_MEMORY_LIMIT=128M
PROXY_CPU_LIMIT=0.25
